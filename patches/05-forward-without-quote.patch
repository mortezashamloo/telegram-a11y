         if (messageObject == null) return;
         
         // بررسی سوئیچ تنظیمات دسترس‌پذیری
         boolean noQuote = A11yConfig.isForwardNoQuoteSavedEnabled();
         
         SendMessagesHelper.getInstance(currentAccount).sendMessage(
             messageObject,
             UserConfig.getInstance(currentAccount).getClientUserId(),
             null, 
             null, 
             noQuote, // اگر روشن باشد true (بدون نقل‌قول) و اگر خاموش باشد false (با نقل‌قول)
             0
         );
     }